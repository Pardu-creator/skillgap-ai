{
  "name": "selenium-tests",
  "version": "1.0.0",
  "description": "Selenium E2E Tests for Skill-Gap AI Platform (300+ test cases)",
  "main": "tests/login-tests.js",
  "scripts": {
    "test": "mocha tests/login-tests.js --timeout 30000 --reporter spec",
    "test:json": "mocha tests/login-tests.js --timeout 30000 --reporter json --reporter-option output=reports/selenium-results.json",
    "test:ci": "mocha tests/login-tests.js --timeout 30000 --reporter json > reports/selenium-results.json",
    "report": "node generate_report.js reports/selenium-results.json",
    "test:full": "npm run test:json && npm run report"
  },
  "dependencies": {
    "selenium-webdriver": "^4.20.0",
    "chai": "^4.4.1",
    "exceljs": "^4.4.0",
    "chromedriver": "^124.0.0"
  },
  "devDependencies": {
    "mocha": "^10.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
